# MySQL (Aiven)
DB_HOST=your-aiven-mysql-host
DB_PORT=your-aiven-mysql-port
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_DATABASE=etgpt
DB_SSL=true
# Keep the BEGIN CERTIFICATE / END CERTIFICATE lines.
DB_SSL_REJECT_UNAUTHORIZED=true

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Generate a long random secret; never use the example value in production.
JWT_SECRET=replace_with_a_long_random_secret

# Set this to the deployed Vercel frontend origin, without a trailing slash.
FRONTEND_URL=https://your-frontend.vercel.app
